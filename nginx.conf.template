server {
    listen __PORT__;

    # Backend calls MEDIASERVER_API_URL = https://<this-service>.onrender.com/control
    # e.g. POST /control/v3/config/paths/add/<streamKey> -> forwarded to
    # MediaMTX's internal API on 127.0.0.1:9997 as /v3/config/paths/add/<streamKey>
    location /control/ {
        proxy_pass http://127.0.0.1:9997/;
        proxy_http_version 1.1;
    }

    # Everything else (HLS playlists/segments) goes to MediaMTX's internal HLS port.
    # Frontend requests VITE_MEDIA_BASE/<streamKey>/index.m3u8 - forwarded as-is.
    location / {
        proxy_pass http://127.0.0.1:8888/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
    }
}
